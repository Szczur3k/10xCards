# Supabase Configuration (lokalny Docker)
# SUPABASE_URL jest automatycznie ustawiony w docker-compose.yml
SUPABASE_KEY=your-super-secret-jwt-token-with-at-least-32-characters-long

# OpenRouter API (dla AI generation)
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: Mock authentication for development
MOCK_AUTH=false

# Production settings
NODE_ENV=production
PORT=3001

