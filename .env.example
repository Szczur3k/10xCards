# --- Aplikacja ---
OPENROUTER_API_KEY=

# Lokalny Docker: MOCK_AUTH=true (bez GoTrue). Wyłącz na prawdziwym Supabase.
MOCK_AUTH=true

# Opcjonalnie — muszą zgadzać się z seed-simple.sql przy mocku
# MOCK_USER_ID=00000000-0000-4000-8000-000000000001
# MOCK_USER_EMAIL=test@10xdevs.pl

# --- Supabase (SSR) — w compose domyślnie gateway z PostgREST (bez /auth/v1) ---
SUPABASE_URL=http://fiszki-gateway:8000

# JWT z rolą service_role (PostgREST omija RLS) — TYLKO dev/lokalnie.
# Wygeneruj np. na https://jwt.io z payload: {"role":"service_role","iss":"supabase"}
# i sekretem = JWT_SECRET poniżej (ta sama wartość co PGRST_JWT_SECRET).
SUPABASE_KEY=

# --- Wspólny sekret JWT (PostgREST); min. 32 znaki ---
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Postgres — hasło przy pierwszym utworzeniu volume; zmiana bez rm volume = rozjazd ---
POSTGRES_PASSWORD=postgres

HOST_APP_PORT=3001
HOST_POSTGRES_PORT=54332

# SSR w Dockerze: nasłuch na wszystkich interfejsach (domyślnie w compose: 0.0.0.0).
# HOST=localhost w kontenerze = 502 z hosta / Cloudflare Tunnel.
# HOST=0.0.0.0
