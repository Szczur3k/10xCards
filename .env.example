# --- Aplikacja ---
OPENROUTER_API_KEY=
MOCK_AUTH=false

# --- Supabase (SSR tylko — domyślnie wewnętrzny gateway w Dockerze) ---
# Nadpisz tylko jeśli wołasz Supabase spoza kontenera web (np. inny host) albo dodasz klienta w przeglądarce.
SUPABASE_URL=http://fiszki-gateway:8000
SUPABASE_KEY=

# --- GoTrue v2 (wymagane) — adres pod którym „wisi” API auth (u nas nginx w compose) ---
GOTRUE_API_EXTERNAL_URL=http://fiszki-gateway:8000

# --- GoTrue — redirecty / allow list (adres apki w przeglądarce, jeśli nie localhost) ---
# SITE_URL=https://twoja-apka-w-tunnelu
# URI_ALLOW_LIST=https://twoja-apka-w-tunnelu

# --- Wspólny sekret JWT (GoTrue + PostgREST); min. 32 znaki ---
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Postgres — to samo hasło co przy pierwszym utworzeniu volume (GoTrue + PostgREST czytają z tej samej zmiennej).
# Zmiana hasła w .env BEZ usunięcia volume = błąd "password authentication failed".
# W haśle unikaj @ # : / ? (albo koduj w URI). Najprościej na start: postgres
POSTGRES_PASSWORD=postgres

HOST_APP_PORT=3001
HOST_POSTGRES_PORT=54332
