---
import Layout from '../layouts/Layout.astro';

const { isAuthenticated } = Astro.locals;
if (isAuthenticated) {
  return Astro.redirect('/flashcards');
}

const title = "Odzyskaj hasło - 10xCards";
---

<Layout title={title}>
  <main class="min-h-screen flex items-center justify-center bg-background px-4">
    <div class="w-full max-w-md">
      <h1 class="text-2xl font-bold">Odzyskaj hasło</h1>
      
      <!-- Success Message -->
      <div id="successMessage" class="hidden mb-4 p-4 bg-green-50 border border-green-200 rounded-md flex items-center">
        <span class="text-green-600 mr-2">✓</span>
        <span class="text-sm text-green-800">
          Link do resetowania hasła został wysłany na Twój adres email.
        </span>
      </div>

      <!-- Error Message -->
      <div id="errorMessage" class="hidden mb-4 p-4 bg-red-50 border border-red-200 rounded-md flex items-center">
        <span class="text-red-600 mr-2">⚠</span>
        <span id="errorText" class="text-sm text-red-800"></span>
      </div>
      
      <form id="forgotPasswordForm" class="space-y-4">
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="twoj@email.com"
        />
        <button type="submit" id="submitButton">
          Wyślij link resetujący
        </button>
      </form>
    </div>
  </main>

  <script>
    document.getElementById('forgotPasswordForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target as HTMLFormElement);
      const email = formData.get('email') as string;
      
      console.log('Email:', email);
    });
  </script>
</Layout> 