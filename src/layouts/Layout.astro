---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;

// Get user data and CSRF token from middleware
const user = Astro.locals.user;
const csrfToken = Astro.locals.csrfToken;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- CSRF Token for client-side requests -->
    {csrfToken && <meta name="csrf-token" content={csrfToken} />}
  </head>
  <body>
    <!-- User data for client-side auth context -->
    <script id="user-data" type="application/json" set:html={JSON.stringify(user)} />

    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
